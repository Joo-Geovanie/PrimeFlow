# =============================================================================
# PRIMEFLOW B2B INDUSTRIAL PLATFORM & CUSTOM CMS
# Environment Configuration Template (.env.example)
# =============================================================================

# 1. Public Application URL (used for canonical URLs, Open Graph, and sitemap)
NEXT_PUBLIC_SITE_URL=https://primeflow-materials.up.railway.app

# 2. Supabase Connection (PostgreSQL Database, Auth & Storage)
# Leave blank during local offline development to use the built-in persistent
# JSON data store (.data/primeflow-store.json) and local operator console mode.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Server-only secret (NEVER expose to browser / NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 3. Internal Operating Console Security
# HMAC signing secret for HTTP-only staff session cookies
PRIMEFLOW_SESSION_SECRET=replace-with-32-byte-random-hex-secret

# Default operator access key when running without live Supabase Auth credentials
PRIMEFLOW_DEV_PASSCODE=PRIMEFLOW-2026
